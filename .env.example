# Values below are placeholders only. Never commit a real .env.
NODE_ENV=production
PORT=3000
# MongoDB Atlas / replica set is REQUIRED for wallet transactions.
MONGODB_URI=
# Generate separate random values with: node -e "process.stdout.write(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SETTINGS_ENCRYPTION_KEY=
CRON_SECRET=
# HTTPS origin only, for example https://your-domain.example
APP_URL=
ENABLE_SCHEDULER=true
TRUST_PROXY_HOPS=1
# Optional initial provider keys. Can instead be configured, encrypted, in the super admin panel.
SHAKERGAINS_API_KEY=
RESEND_API_KEY=
GIFTEDPAY_API_KEY=
PAYSTACK_SECRET_KEY=
